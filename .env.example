# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password-here
DB_NAME=kospi200
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# Naver Search API
NAVER_CLIENT_ID=your-naver-client-id-here
NAVER_CLIENT_SECRET=your-naver-client-secret-here

# DART (Korean financial disclosure API)
DART_API_KEY=your-dart-api-key-here

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_HOUR=6
SCHEDULER_MINUTE=0

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Rate Limiting
RATE_LIMIT=60/minute

# FMP (Financial Modeling Prep) API - 250 calls/day free
FMP_API_KEY=your-fmp-api-key-here

# AI Analysis APIs (Gemini 15RPM free, Groq 30RPM free)
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# Debug
DEBUG=false
